#!/usr/bin/env bash
set -x
set -e
# CustomPiOS auto-hotspot module
# Sets up an automatic fallback WiFi hotspot for first-time setup, using a
# NetworkManager AP connection profile instead of the old hostapd/dnsmasq/
# wpa_supplicant stack (RatOS's build already runs NetworkManager - see
# CustomPiOS's own network module default of NETWORK_NETWORK_MANAGER=yes -
# and the old stack fights it rather than working alongside it).
#
# NetworkManager's ipv4.method=shared on an AP-mode profile provides its
# own DHCP server and NAT, so hostapd/dnsmasq/iptables aren't needed at
# all. The fallback behavior (only broadcast the hotspot when no known
# WiFi network is reachable) comes from autoconnect-priority=-999 on the
# profile itself: NetworkManager always tries higher-priority (real,
# user-added) connections first and only falls through to this profile
# when none of them can activate - no custom polling/switching script
# required.
########

source /common.sh

# Unpack the AP connection profile (and anything else under filesystem/root)
unpack /filesystem/root /

# Set hotspot name, password and channel
sed -i s"/HOTSPOT_NAME/$HOTSPOT_NAME/g" /etc/NetworkManager/system-connections/ratos-hotspot.nmconnection
sed -i s"/HOTSPOT_PASSWORD/$HOTSPOT_PASSWORD/g" /etc/NetworkManager/system-connections/ratos-hotspot.nmconnection
sed -i s"/HOTSPOT_CHANNEL/$HOTSPOT_CHANNEL/g" /etc/NetworkManager/system-connections/ratos-hotspot.nmconnection

# NetworkManager refuses to load connection profiles containing secrets
# (psk=) unless they're owned by root and not readable by group/other.
# unpack preserves the mode git tracked, which for a non-executable file
# is 644, not 600 - fix it explicitly.
chown root:root /etc/NetworkManager/system-connections/ratos-hotspot.nmconnection
chmod 600 /etc/NetworkManager/system-connections/ratos-hotspot.nmconnection
