[connection]
id=RatOS-Hotspot
uuid=8a2c9b7e-3f14-4d6a-91c5-6e8fdeadbeef
type=wifi
interface-name=wlan0
autoconnect=true
autoconnect-priority=-999

[wifi]
mode=ap
ssid=HOTSPOT_NAME
band=bg
channel=HOTSPOT_CHANNEL

[wifi-security]
key-mgmt=wpa-psk
psk=HOTSPOT_PASSWORD

[ipv4]
method=shared

[ipv6]
method=ignore
