#!/bin/bash
# shellcheck disable=all
[ -n "$IS_REQ_PREINSTALL_VENV_DIR" ] || IS_REQ_PREINSTALL_VENV_DIR=/home/${BASE_USER}/klippy-env
[ -n "$IS_REQ_PREINSTALL_DEPS" ] || IS_REQ_PREINSTALL_DEPS="python3-numpy python3-matplotlib \
libatlas3-base libatlas-base-dev libgfortran5"
# numpy<=1.23.4 doesn't build on Python 3.13 (Trixie) - its legacy build
# backend calls pkgutil.ImpImporter, removed in 3.12+. Same issue and fix
# as MainsailOS's own modules/generic/50-klipper: install unpinned.
[ -n "$IS_REQ_PREINSTALL_PIP" ] || IS_REQ_PREINSTALL_PIP="numpy"
