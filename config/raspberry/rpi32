#!/usr/bin/env bash
# Shebang for better file detection

# Rolling current-release image, matching the fix applied to rpi64: the
# previously pinned 2023-05-03 Bullseye image causes the same cascade of
# stale-base-image issues (missing sudoers, old camera-streamer branch
# selection, etc.) regardless of 32-bit vs 64-bit.
DOWNLOAD_URL_CHECKSUM="https://downloads.raspberrypi.org/raspios_lite_armhf_latest.sha256"
DOWNLOAD_URL_IMAGE="https://downloads.raspberrypi.org/raspios_lite_armhf_latest.torrent"

export DOWNLOAD_URL_CHECKSUM
export DOWNLOAD_URL_IMAGE
